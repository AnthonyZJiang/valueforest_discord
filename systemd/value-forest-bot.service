[Unit]
Description=Value Forest Discord Bot
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=yolo
WorkingDirectory=/home/yolo/vf_ws/
ExecStart=/bin/bash /home/yolo/vf_ws/autostart.sh
Restart=on-failure
RestartSec=10
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target